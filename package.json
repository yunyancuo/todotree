{
  "name": "todotree",
  "version": "1.1.0",
  "description": "交互式 TodoTree 桌面应用 - 读 markdown 待办树，打勾划线，重启自动清理",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-builder@25.1.8": true
  },
  "build": {
    "appId": "com.todotree.app",
    "productName": "TodoTree",
    "copyright": "Copyright © 2026 TodoTree",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TodoTree",
      "artifactName": "TodoTree-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
